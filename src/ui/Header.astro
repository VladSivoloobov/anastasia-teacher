---
import Container from "./Container.astro";
---

<header class="header fixed top-0 left-0 w-full py-4 z-50 transition-colors duration-200 md:w-full md:h-19.5">
  <Container class="flex flex-col md:items-end md:h-full">
    <button class="burger-button hidden md:block">
      <span class="ms text-md">menu</span>
    </button>

    <nav class="md:w-full md:bg-white md:h-0 md:overflow-hidden">
      <ul class="flex md:flex-col md:items-center gap-4">
        <li>
          <a href="#hero">Главная</a>
        </li>
        <li>
          <a href="#about">Обо мне</a>
        </li>
        <li>
          <a href="#steps">Шаги</a>
        </li>
        <li>
          <a href="#feature">Преимущества</a>
        </li>
        <li>
          <a href="#rating">Отзывы</a>
        </li>
        <li>
          <a href="#pricing">Цены</a>
        </li>
        <li>
          <a href="#faqs">Вопросы</a>
        </li>
      </ul>
    </nav>
  </Container>
</header>

<style>
  .header.scrolled {
    background: white;
  }

  .header {
    transition: height 0.5s;
  }

  .header.show {
    height: 100%;
  }

  .header.show nav {
    height: 100%;
  }

  .header nav {
    transition: height 0.5s;
  }
</style>

<script>
  const header = document.querySelector(".header");

  function setHeaderBackground() {
    if (window.scrollY > 50) {
      header?.classList.add("scrolled");
    } else {
      header?.classList.remove("scrolled");
    }
  }

  window.addEventListener("scroll", () => {
    setHeaderBackground();
  });

  window.addEventListener("DOMContentLoaded", () => {
    setHeaderBackground();
  });

  const headerButton = document.querySelector(".burger-button");

  headerButton?.addEventListener("click", () => {
    header?.classList.toggle("show");
  });

  const navItems = document.querySelectorAll("nav li a");
  navItems.forEach((item) => {
    item.addEventListener("click", () => {
      header?.classList.remove("show");
    });
  });
</script>
